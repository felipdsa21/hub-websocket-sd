{
  "printWidth": 100,
  "singleQuote": true,
  "overrides": [
    {
      "files": "*.html",
      "options": {
        "parser": "angular"
      }
    }
  ],
  "plugins": ["@trivago/prettier-plugin-sort-imports"],
  "importOrder": ["^@/", "^\\."],
  "importOrderParserPlugins": ["typescript", "jsx", "decorators"],
  "importOrderSortSpecifiers": true
}
